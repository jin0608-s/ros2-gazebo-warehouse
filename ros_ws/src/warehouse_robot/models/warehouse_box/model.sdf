<?xml version="1.0" ?>

<sdf version="1.8">

  <model name="warehouse_box">

    <static>false</static>

    <link name="box_link">

      <!-- Collision -->
      <collision name="collision">

        <geometry>
          <box>
            <size>0.4 0.4 0.4</size>
          </box>
        </geometry>

      </collision>


      <!-- Visual -->
      <visual name="visual">

        <geometry>
          <box>
            <size>0.4 0.4 0.4</size>
          </box>
        </geometry>

        <!-- 기본 색상: 빨간색 -->
        <material>

          <ambient>0.8 0.1 0.1 1</ambient>

          <diffuse>0.9 0.1 0.1 1</diffuse>

          <specular>0.2 0.2 0.2 1</specular>

        </material>

      </visual>


      <!-- Inertial -->
      <inertial>

        <mass>0.5</mass>

        <inertia>

          <ixx>0.0133</ixx>
          <iyy>0.0133</iyy>
          <izz>0.0133</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>

        </inertia>

      </inertial>

    </link>

  </model>

</sdf>