<?xml version="1.0" ?>

<sdf version="1.8">

  <model name="green_box">

    <static>false</static>

    <link name="box_link">

      <collision name="collision">

        <geometry>
          <box>
            <size>0.4 0.4 0.4</size>
          </box>
        </geometry>

      </collision>


      <visual name="visual">

        <geometry>
          <box>
            <size>0.4 0.4 0.4</size>
          </box>
        </geometry>

        <material>

          <ambient>0.1 0.7 0.2 1</ambient>
          <diffuse>0.1 0.9 0.2 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>

        </material>

      </visual>


      <inertial>

        <mass>0.5</mass>

        <inertia>

          <ixx>0.0133</ixx>
          <iyy>0.0133</iyy>
          <izz>0.0133</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>

        </inertia>

      </inertial>

    </link>

  </model>

</sdf>