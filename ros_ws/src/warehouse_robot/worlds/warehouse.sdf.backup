<?xml version="1.0" ?>
<sdf version="1.8">

  <world name="warehouse">

    <!-- ========================= -->
    <!-- Physics -->
    <!-- ========================= -->

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>


    <!-- ========================= -->
    <!-- Scene / Lighting -->
    <!-- ========================= -->

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>true</shadows>
    </scene>


    <!-- ========================= -->
    <!-- Sun -->
    <!-- ========================= -->

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>

      <direction>-0.5 0.5 -1</direction>
    </light>


    <!-- ========================= -->
    <!-- Ground -->
    <!-- ========================= -->

    <model name="ground">

      <static>true</static>

      <link name="ground_link">

        <collision name="collision">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>

        </collision>


        <visual name="visual">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>

          <material>

            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================= -->
    <!-- RED SHELF -->
    <!-- ================================================= -->

    <model name="red_shelf">

      <static>true</static>

      <!-- 선반을 바닥에 배치 -->
      <pose>2.5 1.8 0 0 0 0</pose>

      <link name="shelf_link">


        <!-- Back -->
        <visual name="back">

          <pose>0 0 1.0 0 0 0</pose>

          <geometry>
            <box>
              <size>2.0 0.15 2.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>

        </visual>


        <!-- Bottom -->
        <visual name="bottom">

          <pose>0 0 0.1 0 0 0</pose>

          <geometry>
            <box>
              <size>2.0 1.0 0.15</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>

        </visual>


        <!-- Middle -->
        <visual name="middle">

          <pose>0 0 1.0 0 0 0</pose>

          <geometry>
            <box>
              <size>2.0 1.0 0.15</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>

        </visual>


        <!-- Top -->
        <visual name="top">

          <pose>0 0 1.9 0 0 0</pose>

          <geometry>
            <box>
              <size>2.0 1.0 0.15</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================= -->
    <!-- BLUE SHELF -->
    <!-- ================================================= -->

    <model name="blue_shelf">

      <static>true</static>

      <pose>2.5 -1.8 0 0 0 0</pose>

      <link name="shelf_link">


        <visual name="back">

          <pose>0 0 1.0 0 0 0</pose>

          <geometry>
            <box>
              <size>2.0 0.15 2.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.1 0.2 0.7 1</ambient>
            <diffuse>0.1 0.3 0.9 1</diffuse>
          </material>

        </visual>


        <visual name="bottom">

          <pose>0 0 0.1 0 0 0</pose>

          <geometry>
            <box>
              <size>2.0 1.0 0.15</size>
            </box>
          </geometry>

          <material>
            <ambient>0.1 0.2 0.7 1</ambient>
            <diffuse>0.1 0.3 0.9 1</diffuse>
          </material>

        </visual>


        <visual name="middle">

          <pose>0 0 1.0 0 0 0</pose>

          <geometry>
            <box>
              <size>2.0 1.0 0.15</size>
            </box>
          </geometry>

          <material>
            <ambient>0.1 0.2 0.7 1</ambient>
            <diffuse>0.1 0.3 0.9 1</diffuse>
          </material>

        </visual>


        <visual name="top">

          <pose>0 0 1.9 0 0 0</pose>

          <geometry>
            <box>
              <size>2.0 1.0 0.15</size>
            </box>
          </geometry>

          <material>
            <ambient>0.1 0.2 0.7 1</ambient>
            <diffuse>0.1 0.3 0.9 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================= -->
    <!-- GREEN SHELF -->
    <!-- ================================================= -->

    <model name="green_shelf">

      <static>true</static>

      <pose>-2.5 1.8 0 0 0 0</pose>

      <link name="shelf_link">


        <visual name="back">

          <pose>0 0 1.0 0 0 0</pose>

          <geometry>
            <box>
              <size>2.0 0.15 2.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.1 0.6 0.2 1</ambient>
            <diffuse>0.1 0.8 0.2 1</diffuse>
          </material>

        </visual>


        <visual name="bottom">

          <pose>0 0 0.1 0 0 0</pose>

          <geometry>
            <box>
              <size>2.0 1.0 0.15</size>
            </box>
          </geometry>

          <material>
            <ambient>0.1 0.6 0.2 1</ambient>
            <diffuse>0.1 0.8 0.2 1</diffuse>
          </material>

        </visual>


        <visual name="middle">

          <pose>0 0 1.0 0 0 0</pose>

          <geometry>
            <box>
              <size>2.0 1.0 0.15</size>
            </box>
          </geometry>

          <material>
            <ambient>0.1 0.6 0.2 1</ambient>
            <diffuse>0.1 0.8 0.2 1</diffuse>
          </material>

        </visual>


        <visual name="top">

          <pose>0 0 1.9 0 0 0</pose>

          <geometry>
            <box>
              <size>2.0 1.0 0.15</size>
            </box>
          </geometry>

          <material>
            <ambient>0.1 0.6 0.2 1</ambient>
            <diffuse>0.1 0.8 0.2 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================= -->
    <!-- CONVEYOR -->
    <!-- ================================================= -->

    <model name="conveyor">

    <static>true</static>

    <pose>0 0 0.25 0 0 0</pose>

    <link name="conveyor_link">

        <!-- ========================= -->
        <!-- Conveyor Base Collision -->
        <!-- ========================= -->

        <collision name="base_collision">

        <pose>0 0 0 0 0 0</pose>

        <geometry>
            <box>
            <size>7.0 1.2 0.5</size>
            </box>
        </geometry>

        </collision>


        <!-- ========================= -->
        <!-- Conveyor Base Visual -->
        <!-- ========================= -->

        <visual name="base">

        <pose>0 0 0 0 0 0</pose>

        <geometry>
            <box>
            <size>7.0 1.2 0.5</size>
            </box>
        </geometry>

        <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>

        </visual>


        <!-- ========================= -->
        <!-- Conveyor Surface -->
        <!-- ========================= -->

        <visual name="top">

        <pose>0 0 0.3 0 0 0</pose>

        <geometry>
            <box>
            <size>7.0 1.2 0.1</size>
            </box>
        </geometry>

        <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>

        </visual>


        <!-- ========================= -->
        <!-- Left Rail -->
        <!-- ========================= -->

        <collision name="left_rail_collision">

        <pose>0 0.58 0.55 0 0 0</pose>

        <geometry>
            <box>
            <size>7.0 0.1 0.4</size>
            </box>
        </geometry>

        </collision>


        <visual name="left_rail">

        <pose>0 0.58 0.55 0 0 0</pose>

        <geometry>
            <box>
            <size>7.0 0.1 0.4</size>
            </box>
        </geometry>

        <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>

        </visual>


        <!-- ========================= -->
        <!-- Right Rail -->
        <!-- ========================= -->

        <collision name="right_rail_collision">

        <pose>0 -0.58 0.55 0 0 0</pose>

        <geometry>
            <box>
            <size>7.0 0.1 0.4</size>
            </box>
        </geometry>

        </collision>


        <visual name="right_rail">

        <pose>0 -0.58 0.55 0 0 0</pose>

        <geometry>
            <box>
            <size>7.0 0.1 0.4</size>
            </box>
        </geometry>

        <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>

        </visual>

    </link>

    </model>

    <!-- ========================= -->
    <!-- Warehouse Boxes -->
    <!-- ========================= -->

    <!-- Red Box -->
    <include>
        <uri>model://red_box</uri>
        <name>red_box</name>
        <pose>-1.5 0 0.85 0 0 0</pose>
    </include>


    <!-- Blue Box -->
    <include>
        <uri>model://blue_box</uri>
        <name>blue_box</name>
        <pose>0 0 0.85 0 0 0</pose>
    </include>


    <!-- Green Box -->
    <include>
        <uri>model://green_box</uri>
        <name>green_box</name>
        <pose>1.5 0 0.85 0 0 0</pose>
    </include>

   
  </world>

</sdf>