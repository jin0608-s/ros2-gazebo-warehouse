    <!-- ================================================= -->
    <!-- CONVEYOR -->
    <!-- ================================================= -->

    <model name="conveyor">

      <static>true</static>

      <pose>0 0.15 0.0625 0 0 0</pose>

      <link name="conveyor_link">

        <!-- Base -->

        <collision name="base_collision">

