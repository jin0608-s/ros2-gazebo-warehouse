<?xml version="1.0"?>

<sdf version="1.8">

  <world name="warehouse">

    <!-- ================================================= -->
    <!-- PHYSICS -->
    <!-- ================================================= -->

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>


    <!-- ================================================= -->
    <!-- SCENE -->
    <!-- ================================================= -->

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>


    <!-- ================================================= -->
    <!-- SUN -->
    <!-- ================================================= -->

    <light name="sun" type="directional">
      <pose>0 0 2.5 0 0 0</pose>

      <cast_shadows>true</cast_shadows>

      <direction>-0.5 0.5 -1</direction>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>


    <!-- ================================================= -->
    <!-- GROUND -->
    <!-- ================================================= -->

    <model name="ground">

      <static>true</static>

      <link name="ground_link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5 5</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5 5</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================= -->
    <!-- RED SHELF -->
    <!-- ================================================= -->

    <model name="red_shelf">

      <static>true</static>

      <!-- 로봇 뒤쪽 왼쪽 -->
      <pose>-0.32 -0.30 0 0 0 0</pose>

      <link name="shelf_link">

        <!-- Back -->

        <collision name="back_collision">

          <pose>0 0 0.125 0 0 0</pose>

          <geometry>
            <box>
              <size>0.25 0.01875 0.25</size>
            </box>
          </geometry>

        </collision>

        <visual name="back">

          <pose>0 0 0.125 0 0 0</pose>

          <geometry>
            <box>
              <size>0.25 0.01875 0.25</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>

        </visual>


        <!-- Bottom -->

        <collision name="bottom_collision">

          <pose>0 0 0.0125 0 0 0</pose>

          <geometry>
            <box>
              <size>0.25 0.125 0.01875</size>
            </box>
          </geometry>

        </collision>

        <visual name="bottom">

          <pose>0 0 0.0125 0 0 0</pose>

          <geometry>
            <box>
              <size>0.25 0.125 0.01875</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>

        </visual>


        <!-- Middle -->

        <collision name="middle_collision">

          <pose>0 0 0.125 0 0 0</pose>

          <geometry>
            <box>
              <size>0.25 0.125 0.01875</size>
            </box>
          </geometry>

        </collision>

        <visual name="middle">

          <pose>0 0 0.125 0 0 0</pose>

          <geometry>
            <box>
              <size>0.25 0.125 0.01875</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>

